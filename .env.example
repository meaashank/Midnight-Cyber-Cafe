# OPENROUTER_API_KEY_CHAT: Required for AI AIM Chat persona responses (OpenRouter models).
# Configure this in Vercel Environment Variables or runtime secrets.
OPENROUTER_API_KEY_CHAT="MY_OPENROUTER_API_KEY_CHAT"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_VERCEL_SPEED_INSIGHTS_PROJECT_ID: Optional Vercel Speed Insights project ID for RUM analytics.
VITE_VERCEL_SPEED_INSIGHTS_PROJECT_ID=

